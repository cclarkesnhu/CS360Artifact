<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".GoodsMovementActivity">

    <!-- Product ID input -->
    <EditText
        android:id="@+id/editProductId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Product ID"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnCheckId"
        android:layout_marginEnd="8dp"/>

    <Button
        android:id="@+id/btnCheckId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check ID"
        app:layout_constraintTop_toTopOf="@id/editProductId"
        app:layout_constraintStart_toEndOf="@id/editProductId"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Product Info Display -->
    <TextView
        android:id="@+id/tvProductInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/editProductId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Quantity Input -->
    <EditText
        android:id="@+id/editQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter new quantity"
        android:inputType="number"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvProductInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Buttons for Add/Subtract/Set -->

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="+1"
        app:layout_constraintEnd_toStartOf="@+id/btnSubtract"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editQuantity" />

    <Button
        android:id="@+id/btnSubtract"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="-1"
        app:layout_constraintEnd_toStartOf="@+id/btnSetQuantity"
        app:layout_constraintStart_toEndOf="@id/btnAdd"
        app:layout_constraintTop_toBottomOf="@id/editQuantity" />

    <Button
        android:id="@+id/btnSetQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Set"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSubtract"
        app:layout_constraintTop_toBottomOf="@id/editQuantity" />

</androidx.constraintlayout.widget.ConstraintLayout>

